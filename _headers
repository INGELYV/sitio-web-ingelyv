# Cloudflare Pages: cabeceras por ruta.
# El HTML se revalida siempre; CSS/JS/imágenes llevan versión en la URL (?v=…),
# así que pueden cachearse por mucho tiempo sin riesgo de servir contenido viejo.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=604800
